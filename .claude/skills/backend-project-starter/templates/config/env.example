# Copy to .env and fill in real values.

NODE_ENV=development

# Postgres connection string. Local dev: see docker-compose.yml (bunx
# docker-compose up -d), which creates a database matching this.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# better-auth (src/lib/auth.ts). Generate a secret with:
#   bunx better-auth secret
# or any 32+ byte random string. In production this is validated at
# startup and the process refuses to boot without one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000

# Google native idToken sign-in. All three client ids come from the same
# Google Cloud OAuth client. GOOGLE_CLIENT_SECRET is intentionally left
# empty: the native idToken flow never exchanges it.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (src/utils/storage/) — or any S3-compatible store (S3,
# MinIO) pointed at these same five values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

PORT=8000

# Add REDIS_URL here only if/when chat is scaffolded in (see the
# realtime-chat-system skill) — nothing in this starter needs Redis.
