# Add whichever of these this project's .env / .env.example doesn't already
# have. Grouped by which piece of the chat system needs them — skip a group
# entirely if that piece isn't being installed.

# ── Always needed (chat itself) ──
# Cluster-wide chat presence + cross-instance WebSocket fan-out (src/lib/redis.ts).
# Local dev: docker-compose up -d, or `redis-server` directly.
# A single instance still needs this running — it's a hard dependency of
# /ws, not an optional scaling add-on. Defaults to redis://localhost:6379
# if unset.
REDIS_URL=redis://localhost:6379

# ── Needed if better-auth is being installed (no real auth existed yet) ──
# Generate a secret with: bunx better-auth secret
# or any 32+ byte random string. Validated at startup in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000

# Google native idToken sign-in. All three client ids typically come from
# one Google Cloud OAuth client. GOOGLE_CLIENT_SECRET is intentionally left
# empty for a native idToken flow — it never exchanges it. Swap/extend for
# whatever social providers this project actually uses.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Needed if the storage/image-upload package is being installed ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
